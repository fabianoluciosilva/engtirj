# EngTI RJ — variáveis de ambiente
# Copie para .env.local (desenvolvimento) e cadastre as mesmas no painel da Vercel (produção).
# Nunca versione valores reais.

# ── Site ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://engtirj.com.br
# WhatsApp comercial (DDI + DDD + número, só dígitos). Padrão: 552140421350
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ── Supabase (blog) ───────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave de serviço: só no servidor. Dá acesso total ao banco; nunca expor no navegador.
SUPABASE_SERVICE_ROLE_KEY=

# ── Geração automática de artigos ─────────────────────────────────────────
DEEPSEEK_API_KEY=
FIRECRAWL_API_KEY=
# Protege /api/cron/generate-post (a Vercel envia no cabeçalho Authorization: Bearer ...).
CRON_SECRET=

# ── Painel /admin ─────────────────────────────────────────────────────────
# Senha única de acesso: 16 caracteres ou mais.
ADMIN_PASSWORD=
# Segredo que assina o cookie de sessão: 32 caracteres aleatórios ou mais.
# Gere com:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=
